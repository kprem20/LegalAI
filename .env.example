# NyayaSearch AI — copy this file to .env and fill in values you have.
# Semantic search works without GEMINI or SUPABASE keys.

# Optional: Google Gemini (free-tier). Leave blank to skip AI analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: Supabase for auth, history, bookmarks. Leave blank to use local SQLite.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local embedding model (Sentence Transformers). No API key required.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Persistent ChromaDB directory
CHROMA_PERSIST_DIRECTORY=chroma_data
CHROMA_COLLECTION=nyayasearch_chunks

# Dataset root (do not move or rewrite the original files)
DATASET_DIR=dataset

# Application data (SQLite fallback)
APP_DB_PATH=data/app.db

# Retrieval
DEFAULT_TOP_K=5
CANDIDATE_MULTIPLIER=8

# Indexing (optional limits; omit to process the full dataset)
# INDEX_YEARS=2000,2010,2020,2021,2022,2023,2024,2025
# INDEX_MAX_FILES=

# API
API_HOST=127.0.0.1
API_PORT=8000

# Frontend
NYAYA_API_URL=http://127.0.0.1:8000
SECRET_KEY=change-this-in-local-env
